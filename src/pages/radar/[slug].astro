---
import BaseLayout from '@/layouts/BaseLayout.astro'
import RadarIssueView from '@/components/RadarIssueView.astro'
import { issues, channels, type RadarIssue, type RadarChannel } from '../../lib/radar'
export const prerender = true
export function getStaticPaths() {
  return [
    ...issues.map(issue => ({ params: { slug: issue.date }, props: { issue } })),
    ...(['ai','quant'] as const).map(channel => ({ params: { slug: channel }, props: { issue: issues[0], channel } }))
  ]
}
interface Props { issue: RadarIssue; channel?: RadarChannel }
const { issue, channel } = Astro.props
---
<BaseLayout meta={{ title: `${channel ? channels[channel] : issue.date} · 每日前沿`, description: issue.summary }}>
  <main class='mx-auto max-w-4xl py-8'>
    <RadarIssueView {issue} {channel} archive={!channel} />
  </main>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro'
import RadarIssueView from '@/components/RadarIssueView.astro'
import { issues } from '../../lib/radar'
export const prerender = true
const latest = issues[0]
---
<BaseLayout meta={{ title: '每日前沿 · AI 与量化', description: '国内外模型、产品、Agent、开源、论文、算力、公司动态与量化市场消息。' }}>
  <main class='mx-auto max-w-4xl py-8'>
    {latest ? <RadarIssueView issue={latest} /> : <p>首期整理中。</p>}
  </main>
</BaseLayout>

---
import type { RadarItem } from '../lib/radar'
interface Props { item: RadarItem; date: string }
const { item } = Astro.props
---
<article class='news-item' id={item.id} data-news-item data-category={item.category} data-news-search={`${item.title} ${item.facts} ${item.publisher} ${item.category}`.toLowerCase()}>
  <div class='news-topic'>{item.category}{!item.publishedAt && item.eventAt && <span class='event-date'>事件日期</span>}</div>
  <div class='news-copy'>
    <h3><a href={item.url} target='_blank' rel='noopener noreferrer'>{item.title}</a></h3>
    <p>{item.facts}</p>
    <a class='news-source' href={item.url} target='_blank' rel='noopener noreferrer'>{item.publisher} · 原文 <span class='sr-only'>（新窗口）</span></a>
  </div>
</article>
<style>
.news-item{display:grid;grid-template-columns:8.2rem minmax(0,1fr);gap:1.25rem;padding:1.5rem 0;border-bottom:1px solid hsl(var(--border));scroll-margin-top:5rem}.news-item[hidden]{display:none}.news-topic{font-size:.875rem;color:hsl(var(--muted-foreground));padding-top:.2rem}.event-date{display:block;font-size:.875rem;margin-top:.3rem}.news-copy h3{font-size:1.125rem;font-weight:650;line-height:1.6;letter-spacing:-.015em}.news-copy h3 a:hover{text-decoration:underline;text-underline-offset:.2em}.news-copy>p{font-size:1rem;line-height:1.85;margin:.55rem 0 .7rem;color:hsl(var(--muted-foreground));overflow-wrap:anywhere}.news-source{font-size:.875rem;text-decoration:underline;text-underline-offset:.25em;color:hsl(var(--primary))}@media(max-width:640px){.news-item{grid-template-columns:1fr;gap:.35rem;padding:1.25rem 0}.news-copy h3{font-size:1.1rem}}
</style>

---
import { domains, concepts, lessonUrl } from '../lib/agent-curriculum'
const subtopics: Record<string,string> = {F:'表示 · 概率 · 优化',B:'算法 · 网络 · 存储 · 并发',M:'结构 · 训练 · 对齐 · 推理',A:'提示 · RAG · 记忆 · 工具 · 编排',I:'训练平台 · 推理服务 · Agent 运行时',E:'测量 · 诊断 · 实验 · 数据反馈'}
---
<section class='knowledge-explorer not-prose' aria-label='大模型知识地图' data-knowledge-map>
  <div class='map-topline'><p>选择分支，再展开概念与依赖关系。</p><label><span class='sr-only'>查概念或问题</span><input type='search' data-map-search placeholder='查概念或问题，如 KV、超时' autocomplete='off' /></label></div>
  <div class='map-root'><strong>大模型技术体系</strong><span>六个知识分支，互相支撑</span></div>
  <div class='domain-overview' aria-label='六个知识分支'>
    {domains.map(domain => <button type='button' data-select-domain={domain.id} aria-pressed='false' aria-controls='knowledge-workspace'>
      <strong>{domain.title}</strong><span>{domain.question}</span><small>{subtopics[domain.id]}</small>
    </button>)}
  </div>
  <div class='map-caption'><p>这里的分支表示知识归属，不是必须顺序完成的流程。</p><button type='button' data-expand-tree>查看全部概念</button></div>
  <p class='map-live' data-map-status aria-live='polite'></p>
  <div id='knowledge-workspace' class='map-workspace' hidden>
    <div class='workspace-heading'><h2 data-workspace-title>概念与关系</h2><button type='button' data-close-workspace>收起，回到全景</button></div>
    <div class='map-layout'>
      <div class='map-tree' id='knowledge-concepts' aria-label='概念列表'>
        {domains.map(domain => <section class='tree-domain' data-map-domain={domain.id}>
          <h3>{domain.title}</h3>
          <ul>{concepts.filter(node => node.domain === domain.id).map(node => <li data-concept-row={node.id}>
            <button type='button' data-concept={node.id} aria-pressed='false'><span>{node.title}</span><small>{node.question}</small></button>
            <a class='node-read' href={lessonUrl(node)} aria-label={`阅读全文：${node.title}`}>阅读</a>
          </li>)}</ul>
        </section>)}
      </div>
      <aside class='map-inspector' aria-label='选中概念与依赖关系'>
        <p class='inspector-kicker' data-node-location>选择一个概念</p><h3 data-node-title>它是什么，又与什么有关？</h3>
        <p class='inspector-question' data-node-question>左侧选择概念，即可查看解释和上下游关系。</p>
        <p data-node-thesis></p>
        <a data-node-read class='inspector-read' href='/learn/agent/guide'>先读全景导读</a>
        <div class='relation-section'><h4>理解它，先懂什么</h4><ul data-before-list></ul></div>
        <div class='relation-section'><h4>懂了它，可以继续理解</h4><ul data-after-list></ul></div>
        <details class='relation-section'><summary>跨分支的应用联系</summary><ul data-related-list></ul></details>
        <a class='back-to-concepts' href='#knowledge-concepts'>回到本分支概念列表</a>
      </aside>
    </div>
  </div>
  <noscript><div class='fallback-tree'>{domains.map(domain => <details><summary>{domain.title}</summary><ul>{concepts.filter(n => n.domain === domain.id).map(n => <li><a href={lessonUrl(n)}>{n.title}</a></li>)}</ul></details>)}</div></noscript>
</section>
<script>
  import { concepts, domains, conceptById, connections, lessonUrl, searchConcepts } from '../lib/agent-curriculum'
  function setupKnowledgeMap() {
    const root = document.querySelector<HTMLElement>('[data-knowledge-map]')
    if (!root || root.dataset.ready) return
    root.dataset.ready = 'true'
    const search = root.querySelector<HTMLInputElement>('[data-map-search]')!
    const workspace = root.querySelector<HTMLElement>('#knowledge-workspace')!
    let focusedDomain = ''
    const putText = (selector:string,text:string) => { const el = root.querySelector(selector); if(el) el.textContent = text }
    function setUrl(id?:string) { const url = new URL(location.href); if(id) url.searchParams.set('node',id); else url.searchParams.delete('node'); history.replaceState(history.state,'',url) }
    function showWorkspace(scroll:boolean) {
      workspace.hidden = false
      if(scroll) workspace.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth'})
    }
    function renderRelations(selector:string,entries:{id:string;why:string}[],empty:string) {
      const list = root!.querySelector(selector)!; list.replaceChildren()
      if(!entries.length) { const p=document.createElement('li');p.textContent=empty;list.append(p);return }
      for(const entry of entries) {
        const node=conceptById(entry.id);if(!node)continue
        const li=document.createElement('li'),button=document.createElement('button'),p=document.createElement('p')
        button.type='button';button.textContent=node.title;button.addEventListener('click',()=>selectNode(node.id,true))
        p.textContent=entry.why;li.append(button,p);list.append(li)
      }
    }
    function selectNode(id:string,updateUrl:boolean) {
      const node=conceptById(id);if(!node)return
      focusedDomain=node.domain;search.value=''
      const domain=domains.find(d=>d.id===node.domain)!
      putText('[data-node-location]',`${domain.title} / ${node.id}`)
      putText('[data-node-title]',node.title);putText('[data-node-question]',node.question);putText('[data-node-thesis]',node.thesis)
      const link=root!.querySelector<HTMLAnchorElement>('[data-node-read]')!;link.href=lessonUrl(node);link.textContent='进入完整讲解'
      const {before,after,related}=connections(id)
      renderRelations('[data-before-list]',before.map(e=>({id:e.fromId,why:e.why})),'从本节的问题和定义开始即可。')
      renderRelations('[data-after-list]',after.map(e=>({id:e.to,why:e.why})),'先完成本节算例和自测，再沿应用联系深入。')
      renderRelations('[data-related-list]',related.map(e=>({id:e.fromId===id?e.to:e.fromId,why:e.why})),'本节的应用边界见正文。')
      root!.querySelectorAll<HTMLButtonElement>('[data-concept]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.concept===id)))
      if(updateUrl)setUrl(id)
      applyFilter();showWorkspace(false)
      if(updateUrl && innerWidth < 760) root!.querySelector('.map-inspector')?.scrollIntoView({block:'start',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'})
    }
    function applyFilter() {
      const matches=new Set(searchConcepts(search.value).map(n=>n.id))
      root!.querySelectorAll<HTMLElement>('.map-root,.domain-overview,.map-caption').forEach(el=>{el.hidden=Boolean(search.value.trim())})
      root!.querySelectorAll<HTMLElement>('[data-concept-row]').forEach(row=>{row.hidden=!matches.has(row.dataset.conceptRow!)})
      root!.querySelectorAll<HTMLElement>('[data-map-domain]').forEach(section=>{
        section.hidden=(focusedDomain!=='' && section.dataset.mapDomain!==focusedDomain)||!concepts.some(n=>n.domain===section.dataset.mapDomain&&matches.has(n.id))
      })
      root!.querySelectorAll<HTMLButtonElement>('[data-select-domain]').forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.selectDomain===focusedDomain)))
      putText('[data-workspace-title]',search.value.trim()?'搜索结果':focusedDomain?domains.find(d=>d.id===focusedDomain)!.title:'全部概念')
      putText('[data-map-status]',search.value.trim()?`找到 ${matches.size} 个概念${matches.size?'':'，可以试试“推理”“重试”“评测”等关键词'}。`:'')
    }
    root.querySelectorAll<HTMLButtonElement>('[data-concept]').forEach(button=>button.addEventListener('click',()=>selectNode(button.dataset.concept!,true)))
    root.querySelectorAll<HTMLButtonElement>('[data-select-domain]').forEach(button=>button.addEventListener('click',()=>{
      const node=concepts.find(n=>n.domain===button.dataset.selectDomain)!;selectNode(node.id,false);setUrl(node.id);showWorkspace(true)
    }))
    search.addEventListener('input',()=>{focusedDomain='';applyFilter();showWorkspace(false)})
    root.querySelector('[data-expand-tree]')!.addEventListener('click',()=>{search.value='';focusedDomain='';applyFilter();showWorkspace(true)})
    root.querySelector('[data-close-workspace]')!.addEventListener('click',()=>{workspace.hidden=true;focusedDomain='';search.value='';setUrl();applyFilter();root.scrollIntoView({block:'start'})})
    const queryId=new URL(location.href).searchParams.get('node')
    if(queryId&&conceptById(queryId)){selectNode(queryId,false);showWorkspace(false)}
  }
  setupKnowledgeMap();document.addEventListener('astro:page-load',setupKnowledgeMap)
</script>
<style is:global>
.knowledge-explorer{line-height:1.7;font-size:1rem}.knowledge-explorer [hidden]{display:none!important}.map-topline{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:1.25rem 0}.map-topline p{font-size:.9rem;color:hsl(var(--muted-foreground))}.map-topline label{min-width:17rem}.map-topline input{background:hsl(var(--card));color:inherit;border:1px solid hsl(var(--border));padding:.6rem .85rem;border-radius:.45rem;width:100%;font-size:1rem}.map-root{position:relative;width:fit-content;text-align:center;padding:.6rem 2rem;margin:1.75rem auto 2rem;border:1px solid hsl(var(--border));border-radius:.5rem;background:hsl(var(--muted))}.map-root strong{font-size:1.15rem;font-weight:650}.map-root span{display:block;font-size:.875rem;color:hsl(var(--muted-foreground))}.map-root:after{content:'';position:absolute;height:2rem;width:1px;left:50%;top:100%;background:hsl(var(--border))}.domain-overview{position:relative;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.85rem;padding:1rem 0 0;border-top:1px solid hsl(var(--border))}.domain-overview button{position:relative;text-align:left;padding:1.1rem;border:1px solid hsl(var(--border));border-radius:.5rem;cursor:pointer;background:hsl(var(--card))}.domain-overview button:hover,.domain-overview button[aria-pressed=true]{border-color:hsl(var(--primary));background:hsl(var(--primary)/.06)}.domain-overview strong,.domain-overview span,.domain-overview small{display:block}.domain-overview strong{font-size:1.05rem;font-weight:650}.domain-overview span{font-size:.9rem;margin:.5rem 0 .7rem;color:hsl(var(--muted-foreground))}.domain-overview small{font-size:.875rem;color:hsl(var(--primary))}.map-caption{display:flex;justify-content:space-between;gap:1rem;margin:1rem 0;font-size:.875rem;color:hsl(var(--muted-foreground))}.map-caption button{text-decoration:underline;text-underline-offset:.2em;white-space:nowrap;cursor:pointer;color:hsl(var(--primary))}.map-live{font-size:.9rem;margin:.7rem 0;color:hsl(var(--primary))}.map-workspace{scroll-margin-top:5rem;border-top:1px solid hsl(var(--border));margin-top:2rem;padding-top:1.25rem}.workspace-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.workspace-heading h2{font-size:1.3rem;font-weight:650}.workspace-heading button{font-size:.875rem;text-decoration:underline;cursor:pointer}.map-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);gap:2rem;align-items:start}.tree-domain{margin-bottom:1.5rem}.tree-domain h3{font-weight:600;font-size:.875rem;color:hsl(var(--muted-foreground));margin-bottom:.6rem}.tree-domain ul{list-style:none;margin:0;padding:0}.tree-domain li{display:flex;align-items:center;gap:.4rem;border-bottom:1px solid hsl(var(--border));padding:.3rem 0}.tree-domain button{flex:1;min-width:0;text-align:left;padding:.6rem;border-radius:.4rem;cursor:pointer;border:1px solid transparent}.tree-domain button span{font-size:1rem;font-weight:550}.tree-domain button small{display:block;font-size:.875rem;color:hsl(var(--muted-foreground));margin-top:.3rem}.tree-domain button[aria-pressed=true]{background:hsl(var(--primary)/.08);border-color:hsl(var(--primary))}.node-read{font-size:.875rem;padding:.5rem;text-decoration:underline;text-underline-offset:.2em;color:hsl(var(--primary))}.back-to-concepts{display:block;text-decoration:underline;text-underline-offset:.2em;font-size:.875rem;margin-top:1rem}#knowledge-concepts{scroll-margin-top:5rem}.map-inspector{background:hsl(var(--muted)/.65);border:1px solid hsl(var(--border));border-radius:.6rem;padding:1.4rem;position:sticky;top:5rem;scroll-margin-top:5rem}.inspector-kicker{font-size:.875rem;color:hsl(var(--muted-foreground))}.map-inspector h3{font-size:1.4rem;font-weight:650;margin:.5rem 0}.inspector-question{font-size:1rem;font-weight:600;margin:.8rem 0}.map-inspector [data-node-thesis]{font-size:1rem;color:hsl(var(--muted-foreground))}.inspector-read{display:block;background:hsl(var(--foreground));color:hsl(var(--background));padding:.65rem 1rem;border-radius:.4rem;text-align:center;font-weight:600;margin:1.2rem 0}.inspector-read:hover{color:hsl(var(--background));opacity:.85}.relation-section{border-top:1px solid hsl(var(--border));padding-top:1rem;margin-top:1rem}.relation-section h4,.relation-section summary{font-size:.95rem;font-weight:600}.relation-section summary{cursor:pointer}.relation-section ul{list-style:none;padding:0;margin:0}.relation-section li{margin:.7rem 0;font-size:.9rem}.relation-section button{text-align:left;text-decoration:underline;text-underline-offset:.2em;cursor:pointer;color:hsl(var(--primary));font-size:1rem}.relation-section p{color:hsl(var(--muted-foreground));margin-top:.3rem}.knowledge-explorer button:focus-visible,.knowledge-explorer a:focus-visible,.knowledge-explorer input:focus-visible{outline:2px solid hsl(var(--primary));outline-offset:3px}.fallback-tree details{padding:.75rem;border-bottom:1px solid hsl(var(--border))}.fallback-tree a{text-decoration:underline}@media(max-width:760px){.map-layout{grid-template-columns:1fr;gap:1rem}.map-inspector{position:static}.domain-overview{grid-template-columns:repeat(2,minmax(0,1fr))}.map-topline{display:block}.map-topline label{display:block;margin-top:.75rem}.domain-overview button{padding:.85rem}.map-caption{align-items:start}.map-root{margin-top:1.3rem}}@media(max-width:380px){.domain-overview{grid-template-columns:1fr}.map-caption{display:block}.map-caption button{margin-top:.6rem}}
</style>

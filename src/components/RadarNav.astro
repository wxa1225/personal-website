---
const { active = '' } = Astro.props
const links = [
  ['今日观察', '/radar'], ['AI 前沿', '/radar/ai'], ['量化与市场', '/radar/quant'],
  ['往期', '/radar/archive'], ['信息源', '/radar/sources'], ['编辑方法', '/radar/method']
]
---
<nav class='radar-nav' aria-label='每日观察导航'>
  {links.map(([label, href]) => <a href={href} aria-current={active === href ? 'page' : undefined}>{label}</a>)}
</nav>
<style>
.radar-nav{display:flex;gap:.5rem 1.25rem;flex-wrap:wrap;margin:1.25rem 0 2rem;border-bottom:1px solid var(--border);padding-bottom:1rem;font-size:.95rem}.radar-nav a[aria-current]{font-weight:650;text-decoration:underline;text-underline-offset:.5rem}.radar-nav a:hover{text-decoration:underline}
</style>

<button id='intro-replay' class='intro-replay' type='button' aria-label='重播入场动画'>↻ 重播入场</button>
<dialog id='sia-intro' aria-labelledby='intro-title' aria-describedby='intro-description'>
  <canvas aria-hidden='true'></canvas>
  <div class='intro-steps' aria-hidden='true'><span>explore</span><i></i><span>connect</span><i></i><span>create</span></div>
  <div class='intro-caption'>
    <p class='intro-eyebrow'>A SMALL SPACE FOR CURIOSITY</p>
    <h2 id='intro-title'>Sia<span>'s Space</span></h2>
    <p id='intro-description'>写代码，也把没想明白的事记下来。</p>
    <button id='intro-enter' type='button'>进入 ~/sia <span aria-hidden='true'>→</span></button>
  </div>
  <button id='intro-skip' type='button' autofocus>跳过 →</button>
</dialog>

<style>
  .intro-replay { display: block; margin: 0 0 1rem auto; padding: .4rem .65rem; border-radius: .5rem; color: hsl(var(--muted-foreground)); font-size: .75rem; }
  .intro-replay:hover { background: hsl(var(--muted)); color: hsl(var(--foreground)); }
  #sia-intro { position: fixed; inset: 0; width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; border: 0; padding: 0; overflow: hidden; background: #080d13; color: #e6edf3; }
  #sia-intro::backdrop { background: #080d13; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .intro-steps { position: absolute; top: max(8%, 2rem); width: 100%; display: flex; justify-content: center; align-items: center; gap: 1rem; color: #91b5cc; font: .7rem ui-monospace, monospace; letter-spacing: .16em; }
  .intro-steps i { width: 2rem; height: 1px; background: #91b5cc40; }
  .intro-caption { position: absolute; top: 62%; width: 100%; padding: 0 1.5rem; text-align: center; opacity: 0; transform: translateY(12px); transition: opacity .6s, transform .6s; }
  [data-ready] .intro-caption { opacity: 1; transform: none; }
  .intro-eyebrow { font: .6rem ui-monospace, monospace; letter-spacing: .22em; color: #91b5cc; }
  #intro-title { margin: .6rem 0; font-size: clamp(1.5rem, 4vw, 2.1rem); font-weight: 500; letter-spacing: -.03em; }
  #intro-title span { font-weight: 300; color: #91a2b2; }
  #intro-description { font-size: .85rem; color: #9daebd; }
  #intro-enter { margin-top: 1.3rem; border: 1px solid #769ab84d; border-radius: 999px; padding: .65rem 1.3rem; font: .8rem ui-monospace, monospace; background: #87b6d00b; }
  #intro-enter:hover { background: #87b6d022; }
  #intro-skip { position: absolute; right: max(1.5rem, env(safe-area-inset-right)); bottom: max(1.5rem, env(safe-area-inset-bottom)); color: #91a2b2; padding: .55rem .9rem; border: 1px solid #91a2b230; border-radius: .5rem; font-size: .75rem; }
  button:focus-visible { outline: 2px solid #91b5cc; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .intro-caption { transition: none; transform: none; } }
  @media (max-height: 500px) { .intro-caption { top: 47%; } .intro-steps { top: 1rem; } #intro-enter { margin-top: .6rem; } }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#sia-intro')!
  const replay = document.querySelector<HTMLButtonElement>('#intro-replay')!
  const canvas = dialog.querySelector('canvas')!
  const ctx = canvas.getContext('2d')
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
  const seenKey = 'sia:intro:seen:v1'
  let frame = 0
  let timer = 0
  let previousOverflow = ''
  let previousFocus: HTMLElement | null = null
  let started = 0
  let width = 0
  let height = 0
  let particles: { x: number; y: number; tx: number; ty: number; radius: number }[] = []

  function size() {
    width = window.innerWidth
    height = window.innerHeight
    const dpr = Math.min(window.devicePixelRatio || 1, 2)
    canvas.width = width * dpr
    canvas.height = height * dpr
    ctx?.setTransform(dpr, 0, 0, dpr, 0, 0)
    const mask = document.createElement('canvas')
    mask.width = width
    mask.height = height
    const pen = mask.getContext('2d', { willReadFrequently: true })!
    pen.font = `700 ${Math.min(width * .36, height * .36, 270)}px system-ui`
    pen.textAlign = 'center'
    pen.textBaseline = 'middle'
    pen.fillText('SIA', width / 2, height * .38)
    const pixels = pen.getImageData(0, 0, width, height).data
    particles = []
    const step = width < 640 ? 6 : 8
    for (let y = 0; y < height; y += step) {
      for (let x = 0; x < width; x += step) {
        if (pixels[(y * width + x) * 4 + 3] > 100) {
          particles.push({ x: Math.random() * width, y: Math.random() * height, tx: x, ty: y, radius: .7 + Math.random() * 1.1 })
        }
      }
    }
  }

  function draw(now: number) {
    if (!ctx || !dialog.open) return
    const elapsed = now - started
    const progress = reduced.matches ? 1 : Math.min(1, Math.max(0, (elapsed - 350) / 2100))
    const ease = 1 - Math.pow(1 - progress, 3)
    ctx.clearRect(0, 0, width, height)
    for (const p of particles) {
      const x = p.x + (p.tx - p.x) * ease
      const y = p.y + (p.ty - p.y) * ease
      ctx.beginPath()
      ctx.fillStyle = `rgba(143,193,220,${.35 + ease * .5})`
      ctx.arc(x, y, p.radius, 0, Math.PI * 2)
      ctx.fill()
    }
    if (progress > .7) dialog.dataset.ready = ''
    if (progress < 1) frame = requestAnimationFrame(draw)
  }

  function close() { if (dialog.open) dialog.close() }
  function open() {
    if (dialog.open) return
    previousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null
    previousOverflow = document.documentElement.style.overflow
    delete dialog.dataset.ready
    dialog.showModal()
    document.documentElement.style.overflow = 'hidden'
    try { sessionStorage.setItem(seenKey, '1') } catch { /* Storage can be unavailable. */ }
    size()
    started = performance.now()
    if (reduced.matches || !ctx) dialog.dataset.ready = ''
    draw(started)
    if (!reduced.matches) timer = window.setTimeout(close, 5600)
  }
  dialog.addEventListener('close', () => {
    cancelAnimationFrame(frame)
    clearTimeout(timer)
    document.documentElement.style.overflow = previousOverflow
    previousFocus?.focus({ preventScroll: true })
  })
  replay.addEventListener('click', open)
  document.querySelector('#intro-enter')!.addEventListener('click', close)
  document.querySelector('#intro-skip')!.addEventListener('click', close)
  window.addEventListener('resize', () => { if (dialog.open) { size(); cancelAnimationFrame(frame); draw(performance.now()) } })
  window.addEventListener('pagehide', close)
  reduced.addEventListener('change', () => { if (reduced.matches) close() })
  let seen = false
  try { seen = sessionStorage.getItem(seenKey) === '1' } catch { /* Keep the page usable without storage. */ }
  if (!seen && !reduced.matches) open()
</script>
